# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Build output
# ⚠️【前后端对齐·铁律 1/2】不要单独 ignore source/backend/static —— Flask 生产环境从这里读前端！
#    构建时 vite 插件会自动把 dist/* 同步到 backend/static。
#    一键部署：bash deploy.sh
dist/
# 前端构建产物（两份：本地 dist、生产 backend/static）都纳入版本控制
!source/frontend/dist/
!source/frontend/dist/**
# ⚠️【前后端对齐·铁律 2/2】backend/static 必须被 git 跟踪（静态产物）：
!source/backend/static/index.html
!source/backend/static/version.json
!source/backend/static/assets/
!source/backend/static/assets/**

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Uploads
.uploads/
uploads/

# Database
*.db
*.sqlite
*.sqlite3

# Gradle (Android build remnants)
.gradle/
gradle/
*.gradle
gradlew*
gradle-wrapper.*

# Test
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*

# Misc
*.zip
*.tar.gz
*.rar
.ew-tmp/

# 备份文件库（本地保存版本快照，不进仓库）
backups/
