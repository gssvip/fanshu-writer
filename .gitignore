.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Uploads
.uploads/
uploads/

# Database
*.db
*.sqlite
*.sqlite3

# Gradle (Android build remnants)
.gradle/
gradle/
*.gradle
gradlew*
gradle-wrapper.*

# Test
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*

# Misc
*.zip
*.tar.gz
*.rar
.ew-tmp/
